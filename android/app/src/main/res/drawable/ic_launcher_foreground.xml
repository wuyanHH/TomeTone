<?xml version="1.0" encoding="utf-8"?>
<!-- 前景层：线描展开书 + 书口上升的五根声纹。
     几何与方向稿 docs/design-preview/icon-v3/src/ic_launcher_foreground.svg 逐点一致
     （那份稿子整组下移 7.5dp，这里把 7.5 直接烘焙进坐标，省掉一层 group transform，
     门禁才能不依赖 transform 就复算出真实外接）。
     外接 Ø54.0dp，距 Ø66 安全圆 6.0dp。改几何或笔宽后必须重跑
     dart run tool/ci/check_brand_assets.dart。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 展开的书：顶边两侧上翘、中缝下塌，页脚在书脊处下探成 V -->
    <path
        android:pathData="M54,57.5 C48.5,52 42,51 34,52.5 L34,69.5 C42,68 48.5,69 54,75.5 C59.5,69 66,68 74,69.5 L74,52.5 C66,51 59.5,52 54,57.5 Z"
